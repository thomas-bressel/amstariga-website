---
import TapeCounter from './TapeCounter';
import './Header.css';
import './TapeCounter.css';
---
<header class="main-header">

  <!-- FRAGMENT 1 : logo + actions mobile -->
  <div class="hf hf--logo ">
    <div class="hf-logo-row">
      <div class="logo">

        <!-- Logo complet — desktop uniquement -->
        <svg class="logo-svg logo-svg--full" viewBox="0 0 280 64" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="grad-amstrad" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%"   stop-color="#FFFFFF"/>
              <stop offset="40%"  stop-color="#FFFFFF"/>
              <stop offset="40%"  stop-color="#AA1111"/>
              <stop offset="60%"  stop-color="#AA1111"/>
              <stop offset="60%"  stop-color="#FFFFFF"/>
              <stop offset="100%" stop-color="#FFFFFF"/>
            </linearGradient>
            <linearGradient id="grad-atari" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%"   stop-color="#FF0000"/>
              <stop offset="40%"  stop-color="#FFEE00"/>
              <stop offset="100%" stop-color="#00CCFF"/>
            </linearGradient>
            <linearGradient id="grad-amiga" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%"   stop-color="#0033CC"/>
              <stop offset="20%"  stop-color="#00AAFF"/>
              <stop offset="40%"  stop-color="#00DD44"/>
              <stop offset="60%"  stop-color="#FFEE00"/>
              <stop offset="80%"  stop-color="#FF6600"/>
              <stop offset="100%" stop-color="#EE1111"/>
            </linearGradient>
          </defs>
          <text class="logo-t-amstrad" x="10"  y="46">A</text>
          <text class="logo-t-rest"    x="44"  y="48">mst</text>
          <text class="logo-t-atari"   x="86"  y="52">A</text>
          <text class="logo-t-rest"    x="124" y="52">rig</text>
          <text class="logo-t-amiga"   x="172" y="56">A</text>
        </svg>

        <!-- Logo AAA — mobile uniquement, 3 A alignés sur la même baseline -->
        <svg class="logo-svg logo-svg--aaa" viewBox="0 0 96 42" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="grad-amstrad-m" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%"   stop-color="#FFFFFF"/>
              <stop offset="40%"  stop-color="#FFFFFF"/>
              <stop offset="40%"  stop-color="#AA1111"/>
              <stop offset="60%"  stop-color="#AA1111"/>
              <stop offset="60%"  stop-color="#FFFFFF"/>
              <stop offset="100%" stop-color="#FFFFFF"/>
            </linearGradient>
            <linearGradient id="grad-atari-m" x1="0%" y1="0%" x2="0%" y2="100%">
              <stop offset="0%"   stop-color="#FF0000"/>
              <stop offset="40%"  stop-color="#FFEE00"/>
              <stop offset="100%" stop-color="#00CCFF"/>
            </linearGradient>
            <linearGradient id="grad-amiga-m" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%"   stop-color="#0033CC"/>
              <stop offset="20%"  stop-color="#00AAFF"/>
              <stop offset="40%"  stop-color="#00DD44"/>
              <stop offset="60%"  stop-color="#FFEE00"/>
              <stop offset="80%"  stop-color="#FF6600"/>
              <stop offset="100%" stop-color="#EE1111"/>
            </linearGradient>
          </defs>
          <text class="logo-t-amstrad-m" x="2"  y="38">A</text>
          <text class="logo-t-atari-m"   x="34" y="38">A</text>
          <text class="logo-t-amiga-m"   x="66" y="38">A</text>
        </svg>

      </div>
    </div>
    <!-- Actions visibles uniquement en mobile (< 769px) -->
    <div class="hf-mobile-actions">
      <button class="view-btn" id="filter-header-btn-m" title="Filtres" style="position:relative">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
          <line x1="11" y1="18" x2="13" y2="18"></line>
        </svg>
        <span class="filter-header-badge" id="filter-header-badge-m" style="display:none"></span>
      </button>
      <div class="view-toggle">
        <button class="view-btn" data-view="grid" aria-label="Vue en grille" title="Vue en grille">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </button>
        <button class="view-btn" data-view="cover" aria-label="Vue en carrousel" title="Vue en carrousel">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>
      <button class="esc-btn" id="esc-btn-m" title="Éteindre">ESC</button>
    </div>
  </div>

  <!-- FRAGMENT 2 : bande centrale -->
  <div class="hf hf--mid ">
    <span id="header-count"><TapeCounter value={0} client:only="react" /></span>
  </div>

  <!-- FRAGMENT 3 : actions -->
  <div class="hf hf--actions ">
    <div class="header-actions">
      <button class="filter-header-btn" id="filter-header-btn" title="Filtres">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="8" y1="12" x2="16" y2="12"></line>
          <line x1="11" y1="18" x2="13" y2="18"></line>
        </svg>
        <span class="filter-header-lbl">FILTRES</span>
        <span class="filter-header-badge" id="filter-header-badge" style="display:none"></span>
      </button>
      <!-- Molette : taille des vignettes (grille et carrousel), ordinateur seulement -->
      <div class="zoom-knob" id="zoom-knob" role="slider" tabindex="0"
           aria-label="Taille des vignettes" aria-valuemin="70" aria-valuemax="150"
           aria-valuenow="100" aria-valuetext="100 %"
           title="Taille des vignettes : molette, glisser ou flèches ; double-clic : 100 %">
        <span class="zoom-knob-dial" aria-hidden="true"><span class="zoom-knob-mark"></span></span>
        <span class="zoom-knob-value" aria-hidden="true">100%</span>
      </div>
      <div class="view-toggle">
        <button class="view-btn" data-view="grid" aria-label="Vue en grille" title="Vue en grille">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
        </button>
        <button class="view-btn" data-view="cover" aria-label="Vue en carrousel" title="Vue en carrousel">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
            <circle cx="12" cy="12" r="3"></circle>
          </svg>
        </button>
      </div>
      <button class="esc-btn" id="esc-btn" title="Éteindre">ESC</button>
    </div>
  </div>

  <!-- FISSURES -->
  <div class="hf-crack hf-crack--1 "></div>
  <div class="hf-crack hf-crack--2 "></div>

</header>

<script is:inline>
  // ESC — desktop et mobile
  ['esc-btn', 'esc-btn-m'].forEach(function (id) {
    var btn = document.getElementById(id);
    if (btn) btn.addEventListener('click', function () {
      localStorage.removeItem('amstariga_visited');
      if (typeof window.crtShutdown === 'function') window.crtShutdown();
    });
  });

  // Restore active view button from localStorage
  (function () {
    var saved = localStorage.getItem('amstariga_view') || 'cover';
    document.querySelectorAll('.view-btn[data-view]').forEach(function (b) {
      b.classList.toggle('active', b.dataset.view === saved);
    });
  })();

  // Bouton FILTRES — desktop et mobile
  ['filter-header-btn', 'filter-header-btn-m'].forEach(function (id) {
    var btn = document.getElementById(id);
    if (btn) btn.addEventListener('click', function () {
      window.dispatchEvent(new CustomEvent('retro:open-filters'));
    });
  });

  // Badge filtre — mis à jour sur les deux boutons
  window.addEventListener('retro:filter-count', function (e) {
    var count = e.detail.count;
    ['filter-header-btn', 'filter-header-btn-m'].forEach(function (id) {
      var btn   = document.getElementById(id);
      var badge = document.getElementById(id.replace('btn', 'badge'));
      if (badge) {
        badge.textContent = count;
        badge.style.display = count > 0 ? 'flex' : 'none';
      }
      if (btn) btn.classList.toggle('has-active', count > 0);
    });
  });

  // Molette ZOOM : taille des vignettes de la grille et du carrousel (--thumb-zoom, utilisée
  // à partir de 769 px), gardée dans localStorage et relue au chargement
  (function () {
    var MIN = 70, MAX = 150, STEP = 10, KEY = 'amstariga_zoom';
    var knob = document.getElementById('zoom-knob');
    var zoom = 100;
    try {
      var saved = parseInt(localStorage.getItem(KEY), 10);
      if (saved >= MIN && saved <= MAX) zoom = saved;
    } catch (e) {}

    function apply(value, save) {
      var next = Math.max(MIN, Math.min(MAX, Math.round(value / STEP) * STEP));
      var changed = next !== zoom;
      zoom = next;
      document.documentElement.style.setProperty('--thumb-zoom', String(zoom / 100));
      if (knob) {
        knob.setAttribute('aria-valuenow', String(zoom));
        knob.setAttribute('aria-valuetext', zoom + ' %');
        knob.querySelector('.zoom-knob-value').textContent = zoom + '%';
        // De -135° (70 %) à +135° (150 %)
        knob.style.setProperty('--knob-angle', ((zoom - MIN) / (MAX - MIN) * 270 - 135) + 'deg');
      }
      if (save && changed) {
        try { localStorage.setItem(KEY, String(zoom)); } catch (e) {}
        window.dispatchEvent(new CustomEvent('retro:zoom', { detail: { zoom: zoom / 100 } }));
      }
    }
    apply(zoom, false);
    if (!knob) return;

    // Molette de la souris : un cran = un pas ; pavé tactile : un pas tous les 100 px
    var rest = 0;
    knob.addEventListener('wheel', function (e) {
      e.preventDefault();
      var px = e.deltaMode === 0 ? e.deltaY : e.deltaY * 33;
      if (Math.abs(px) >= 40) { rest = 0; apply(zoom - Math.sign(px) * STEP, true); return; }
      rest += px;
      if (Math.abs(rest) >= 100) { apply(zoom - Math.sign(rest) * STEP, true); rest = 0; }
    }, { passive: false });

    // Glisser vers le haut ou la droite : plus grand (un pas tous les 15 px)
    var drag = null;
    knob.addEventListener('pointerdown', function (e) {
      drag = { x: e.clientX, y: e.clientY, from: zoom };
      knob.setPointerCapture(e.pointerId);
    });
    knob.addEventListener('pointermove', function (e) {
      if (!drag) return;
      var d = (drag.y - e.clientY) + (e.clientX - drag.x);
      apply(drag.from + Math.round(d / 15) * STEP, true);
    });
    ['pointerup', 'pointercancel'].forEach(function (type) {
      knob.addEventListener(type, function () { drag = null; });
    });

    knob.addEventListener('dblclick', function () { apply(100, true); });
    knob.addEventListener('keydown', function (e) {
      var keys = { ArrowUp: STEP, ArrowRight: STEP, ArrowDown: -STEP, ArrowLeft: -STEP, PageUp: 2 * STEP, PageDown: -2 * STEP };
      if (e.key in keys) apply(zoom + keys[e.key], true);
      else if (e.key === 'Home') apply(MIN, true);
      else if (e.key === 'End') apply(MAX, true);
      else return;
      e.preventDefault();
    });
  })();

  document.querySelectorAll('.view-btn[data-view]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var view = this.dataset.view;
      document.querySelectorAll('.view-btn[data-view]').forEach(function (b) { b.classList.remove('active'); });
      this.classList.add('active');
      window.dispatchEvent(new CustomEvent('retro:view-change', { detail: { view: view } }));
    });
  });
</script>
