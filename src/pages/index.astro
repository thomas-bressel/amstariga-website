---
import Layout from '../layouts/Layout.astro';
import GameGrid from '../components/grid/GameGrid';
import { getIndexData } from '../controllers/index.controller';

const { games, total } = await getIndexData(Astro.url);
---

<Layout>
    <div class="main-layout">
        <GameGrid client:load initialGames={games} initialTotal={total} />
    </div>
</Layout>
