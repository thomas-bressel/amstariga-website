---
import Layout from '../layouts/Layout.astro';
import GameGrid from '../components/grid/GameGrid';
import { getIndexData } from '../controllers/index.controller';

const { games, total, filters } = await getIndexData(Astro.url);
---

<Layout>
    <div class="main-layout">
        <GameGrid client:only="react" initialGames={games} initialTotal={total} initialFilters={filters} />
    </div>
</Layout>
